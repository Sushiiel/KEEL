# ── KEEL production configuration — copy to .env, fill in, keep secret ──

# Signing/session secret (REQUIRED in prod). Generate: openssl rand -hex 32
KEEL_SECRET_KEY=

# Require login for the console (recommended: 1)
KEEL_AUTH_REQUIRED=1

# Serve behind HTTPS? sets Secure cookies (recommended behind a TLS proxy)
KEEL_HTTPS=1

# ── Payments (India: Razorpay) ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
KEEL_PRICE_INR=830

# ── Payments (elsewhere: Stripe) — leave Razorpay blank to use Stripe ─────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: local dev unlock code (leave unset in prod)
# KEEL_UNLOCK_CODE=DEV-UNLOCK

# Optional integrations
# KEEL_LLM_MODEL=claude-sonnet-5
# OTEL_EXPORTER_OTLP_ENDPOINT=
# QDRANT_URL=

# ── LLM (free): Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=
KEEL_LLM_MODEL=gemini-flash-latest

# ── LangSmith tracing (optional) ──────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

# Firebase web config is public by design (analytics) and lives in the site HTML.
